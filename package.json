{
  "name": "pi-viewer",
  "version": "0.1.0",
  "description": "A live dashboard of your pi coding agent sessions: context, tokens, cost, turns and tools, in the browser",
  "license": "MIT",
  "keywords": ["pi", "pi-coding-agent", "dashboard", "tokens", "context"],
  "type": "module",
  "bin": { "pi-viewer": "./dist/cli.js" },
  "files": ["dist"],
  "scripts": {
    "build": "vite build && bun build src/cli.ts --target node --outfile dist/cli.js && chmod +x dist/cli.js",
    "dev": "bun scripts/dev.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build",
    "screenshot": "bun scripts/screenshot/shoot.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "playwright": "^1.65.1",
    "solid-js": "^1.9.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
