{
  "name": "pi-viewer",
  "version": "0.1.0",
  "description": "A live dashboard of your pi coding agent sessions: context, tokens, cost, turns and tools, in the browser",
  "license": "MIT",
  "keywords": ["pi-package", "pi", "pi-coding-agent", "dashboard", "tokens", "context"],
  "type": "module",
  "bin": {
    "pi-viewer": "./dist/cli.js"
  },
  "files": ["dist"],
  "pi": {
    "extensions": ["./dist/extension.js"]
  },
  "scripts": {
    "build": "vite build && bun build src/cli.ts --target node --outfile dist/cli.js && chmod +x dist/cli.js && bun build src/extension.ts --target node --outfile dist/extension.js --external '@earendil-works/*'",
    "dev": "bun scripts/dev.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build",
    "screenshot": "bun scripts/screenshot/shoot.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.1",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "highlight.js": "^11.12.0",
    "playwright": "^1.65.1",
    "solid-js": "^1.9.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
